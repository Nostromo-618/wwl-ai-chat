{
  "name": "@wwl/wwl-ai-chat",
  "version": "0.2.0",
  "private": true,
  "description": "Headless browser-local AiChat with LiteRT, WebLLM and Transformers.js adapters, local guardrails and safe markdown",
  "type": "module",
  "homepage": "https://github.com/nostromo-618/wwl-ai-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostromo-618/wwl-ai-chat.git"
  },
  "bugs": {
    "url": "https://github.com/nostromo-618/wwl-ai-chat/issues"
  },
  "license": "MIT",
  "author": "nostromo-618",
  "keywords": [
    "wwl",
    "ai-chat",
    "gemma",
    "litert",
    "webllm",
    "guardrails",
    "on-device"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "src/guardrails/data/provenance.json",
    "src/guardrails/data/*LICENSE.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./guardrails/llm": {
      "types": "./dist/guardrails/llm.d.ts",
      "import": "./dist/guardrails/llm.js",
      "require": "./dist/guardrails/llm.cjs"
    },
    "./guardrails/tools": {
      "types": "./dist/guardrails/tools.d.ts",
      "import": "./dist/guardrails/tools.js",
      "require": "./dist/guardrails/tools.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "node scripts/verify-guardrail-data.mjs && vitest run --coverage",
    "test:e2e": "node scripts/ensure-gemma-e2e-model.mjs && pnpm run build && playwright test -c tests/e2e/playwright.config.ts",
    "test:local": "pnpm run test:ci && pnpm run test:e2e",
    "guardrails:evaluate": "node scripts/evaluate-guardrails.mjs",
    "guardrails:verify": "node scripts/verify-guardrail-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@litert-lm/core": "0.17.1",
    "@litertjs/wasm-utils": "2.5.3",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^6.4.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "obscenity": "0.4.6"
  }
}
